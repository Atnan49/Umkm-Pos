{
  "name": "bukukasir-umkm",
  "version": "1.0.0",
  "description": "Aplikasi Kasir POS Desktop UMKM dengan Integrasi Laser Scanner dan Printer Thermal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "prepare:android": "node prepare-www.js && npx cap sync android",
    "build:apk": "node prepare-www.js && npx cap sync android && cd android && gradlew assembleDebug"
  },
  "keywords": [
    "pos",
    "kasir",
    "umkm",
    "desktop",
    "electron",
    "thermal-printer",
    "laser-scanner"
  ],
  "author": "Atnan49",
  "license": "SEE LICENSE IN LICENSE",
  "build": {
    "appId": "com.atnan49.bukukasir",
    "productName": "BukuKasir UMKM",
    "copyright": "Copyright (c) 2026 Atnan49. All rights reserved.",
    "files": [
      "**/*",
      "!android/**",
      "!www/**",
      "!dist-apk/**",
      "!graphify-out/**",
      "!node_modules/.cache/**",
      "!generate-android-icons.js",
      "!generate-icons.js",
      "!prepare-www.js",
      "!build-apk.bat",
      "!capacitor.config.ts",
      "!DESIGN.md",
      "!MAINTENANCE.md",
      "!*.bat"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Atnan49 UMKM Solutions"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BukuKasir UMKM"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "html5-qrcode": "^2.3.8"
  }
}
